# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# Base de données
DB_USER=xool
DB_PASSWORD=changer-moi
DB_NAME=xool
# 127.0.0.1 et non localhost : sous Windows, localhost passe d'abord par IPv6 (::1),
# où la connexion à la base Docker reste bloquée.
DATABASE_URL=postgresql+asyncpg://xool:changer-moi@127.0.0.1:5432/xool

# API
API_SECRET_KEY=changer-moi-chaine-aleatoire-longue
API_CORS_ORIGINS=http://localhost:3000

# Agent
XOOL_API_URL=http://localhost:8000
XOOL_AGENT_KEY=
XOOL_INTERVAL_SECONDS=60

# Alertes (phase 2)
RESEND_API_KEY=
WA_PHONE_ID=
WA_TOKEN=
